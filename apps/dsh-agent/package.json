{
  "name": "@johnason/dsh-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "johnason-dsh": "src/cli.mjs"
  },
  "scripts": {
    "check:platform": "node scripts/check-platform.mjs",
    "ecosystem:plan": "node scripts/provision-ecosystem.mjs",
    "ecosystem:install": "node scripts/provision-ecosystem.mjs --apply",
    "start": "node src/cli.mjs web",
    "headless": "node src/cli.mjs headless",
    "build:native": "node scripts/build.mjs",
    "doctor": "node src/cli.mjs doctor",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/native-web.test.mjs tests/native-lifecycle.test.mjs tests/native-browser.test.mjs",
    "test:browser": "node --test tests/native-browser.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.62.1"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
